# Copy to .env and adjust. Never commit .env.

# --- Shared local services (docker compose) ---
POSTGRES_USER=pcs
POSTGRES_PASSWORD=pcs_dev_password
POSTGRES_DB=pcs
DATABASE_URL=postgres://pcs:pcs_dev_password@localhost:5432/pcs
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
SESSION_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:5173

# --- Simulated gateway ---
GATEWAY_PORT=4100
GATEWAY_URL=http://localhost:4100
WEBHOOK_HMAC_SECRET=change-me-too
# Fault injection for evaluation M2 (0 to 1)
GATEWAY_FAULT_RATE=0
GATEWAY_SEED=1

# --- Web (Vite exposes only VITE_* to the browser) ---
VITE_API_URL=http://localhost:4000
VITE_USE_MOCKS=true
